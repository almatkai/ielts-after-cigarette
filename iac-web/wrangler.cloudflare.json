{
  "$schema": "cloudflare/node_modules/wrangler/config-schema.json",
  "name": "ielts-web-dev",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".output-cloudflare.local/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "IAC_RENDER",
        "class_name": "IELTSRender"
      }
    ]
  },
  "migrations": [
    {
      "tag": "render-v1",
      "new_sqlite_classes": ["IELTSRender"]
    }
  ]
}
